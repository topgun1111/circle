<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keep-alive: ongoing "running" notification that makes the process a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 200 Hz accelerometer for double-tap-on-back detection -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Lets the setup screen list launchable apps for "hide the button in these apps" -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Xiaomi / HyperOS autostart and battery screens (shortcut buttons) -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_circle"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Setup screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Visual editor for the edge pull zones -->
        <activity
            android:name=".ZoneEditorActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Invisible launcher entry: pick this as the action for the side button
             (or add it as a shortcut) if the button does not send key events. -->
        <activity
            android:name=".TriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_circle"
            android:label="@string/trigger_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fallback for launchers/ROMs that fire a plain ASSIST intent -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Detects the button, takes the screenshot, draws the overlay -->
        <service
            android:name=".CircleService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the side-button accessibility service running in the background" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Quick Settings tile (backup trigger) -->
        <service
            android:name=".CircleTileService"
            android:exported="true"
            android:icon="@drawable/ic_circle"
            android:label="@string/trigger_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Default digital assistant: power-button long-press / assist gesture -->
        <service
            android:name=".AssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_config" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".AssistRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
